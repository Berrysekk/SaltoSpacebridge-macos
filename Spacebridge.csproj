<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>spacebridge</AssemblyName>
    <RootNamespace>SaltoBridge</RootNamespace>
    <Version>2.0.3</Version>
    <RuntimeIdentifier>osx-arm64</RuntimeIdentifier>
    <!-- Compiled ahead of time to one native program: no runtime to carry or warm up, a sixth of the size on disk. -->
    <PublishAot>true</PublishAot>
    <OptimizationPreference>Size</OptimizationPreference>
    <StackTraceSupport>false</StackTraceSupport>
    <IsAotCompatible>true</IsAotCompatible>
    <DebugType>none</DebugType>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- The current servicing release, not the 9.0.6 the SDK carries (GHSA-p3jp-9v83-76w9). -->
    <FrameworkReference Update="Microsoft.NETCore.App" RuntimeFrameworkVersion="9.0.23" />
    <FrameworkReference Update="Microsoft.AspNetCore.App" RuntimeFrameworkVersion="9.0.23" />
    <PackageReference Include="Microsoft.DotNet.ILCompiler" Version="9.0.23" />
    <AssemblyAttribute Include="System.Runtime.Versioning.SupportedOSPlatformAttribute">
      <_Parameter1>macos</_Parameter1>
    </AssemblyAttribute>
    <!-- The same HidSharp the Windows bridge ships (Apache-2.0); it has a macOS (IOKit) backend. -->
    <Reference Include="HidSharp">
      <HintPath>lib/HidSharp.dll</HintPath>
    </Reference>
    <!-- libusb 1.0.30 from Homebrew (LGPL-2.1) and the CoreBluetooth helper build.sh compiles, loaded from next to the executable. -->
    <None Include="lib/*.dylib" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Compile Remove="dist/**;ble/**" />
  </ItemGroup>

</Project>
